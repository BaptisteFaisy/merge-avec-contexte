# Formatage déclaratif du dépôt (audit 75) — lu par les éditeurs courants.
# Les règles vérifiables en CI vivent dans tools/check-style.mjs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
